#!/usr/bin/env python3
# /// script
# requires-python = ">=3.9"
# dependencies = ["Pillow>=9.0", "numpy>=1.22"]
# ///
"""Convert an image file to a C++ header containing a shapoco::gfx2d::Texture.

Examples:
  img2cpp sprite.png sprite.hpp                       # RGB565_SWAPPED
  img2cpp -f argb4444 -k "#FF00FF" -d diffusion icon.png icon.hpp
  img2cpp -f gray1 --name logoBits logo.png logo.hpp
"""

import argparse
import os
import sys

from PIL import Image

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import shapogfx_imgconv as conv  # noqa: E402


def generate(args, image):
    w, h, stride, data, elem = conv.convert(image, args.format, args.dither, args.key_color)
    upper, camel = conv.identifiers_from_path(args.output)
    name = args.name or camel
    data_name = f"{name}Data"
    guard = f"{upper}_HPP"
    if args.namespace:
        guard = f"{conv.sanitize_identifier(args.namespace).upper()}_{guard}"

    lines = [
        f"#ifndef {guard}",
        f"#define {guard}",
        "",
        f"// Generated by img2cpp from {os.path.basename(args.input)}",
        f"// {w}x{h}, {args.format}, dither={args.dither}, {stride * h} bytes",
        "",
        '#include "shapoco/gfx2d/surface.hpp"',
        "",
    ]
    if args.namespace:
        lines += [f"namespace {args.namespace} {{", ""]
    lines += conv.format_array(data_name, data, elem)
    lines.append("")
    lines += conv.format_texture(name, args.format, w, h, stride, data_name)
    if args.namespace:
        lines += ["", f"}}  // namespace {args.namespace}"]
    lines += ["", "#endif", ""]
    return "\n".join(lines), w, h


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("input", help="input image (any format Pillow can read)")
    ap.add_argument("output", help="output C++ header (.hpp)")
    ap.add_argument("-f", "--format", choices=conv.FORMATS, default="rgb565_swapped",
                    help="pixel format (default: rgb565_swapped)")
    ap.add_argument("-d", "--dither", choices=conv.DITHERS, default="none",
                    help="dithering (default: none)")
    ap.add_argument("-k", "--key-color", type=conv.parse_key_color, default=None,
                    help="color to make transparent (argb4444), e.g. '#FF00FF' or 'magenta'")
    ap.add_argument("--name", default=None, help="C++ name of the Texture (default: from the output file name)")
    ap.add_argument("--namespace", default=None, help="wrap the definitions in this namespace")
    ap.add_argument("--resize", metavar="WxH", default=None, help="resize before converting, e.g. 64x64")
    ap.add_argument("--pot", action="store_true",
                    help="resize to the nearest power-of-two size (required for 3D textures)")
    args = ap.parse_args()

    image = Image.open(args.input)
    if args.resize:
        w, h = (int(v) for v in args.resize.lower().split("x"))
        image = image.resize((w, h), Image.LANCZOS)
    if args.pot:
        w, h = image.size
        pw, ph = conv.nearest_power_of_two(w), conv.nearest_power_of_two(h)
        if (pw, ph) != (w, h):
            image = image.resize((pw, ph), Image.LANCZOS)

    code, w, h = generate(args, image)
    if not (conv.is_power_of_two(w) and conv.is_power_of_two(h)):
        print(f"note: {w}x{h} is not a power of two; usable in 2D but not as a 3D texture (use --pot)",
              file=sys.stderr)

    out_dir = os.path.dirname(os.path.abspath(args.output))
    os.makedirs(out_dir, exist_ok=True)
    with open(args.output, "w") as f:
        f.write(code)
    print(f"Generated {args.output} ({w}x{h}, {args.format}, dither={args.dither})")


if __name__ == "__main__":
    main()
